---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { restaurants, areaOrder, areaTitle } from '../../data/restaurants';
import { itemListSchema } from '../../lib/schema';

const crumbs = [
  { name: 'ホーム', path: '/' },
  { name: '周辺グルメ', path: '/food' },
];

const mapsUrl = (name: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name + ' 角島')}`;

const byArea = areaOrder.map((area) => ({
  area,
  title: areaTitle[area],
  items: restaurants.filter((r) => r.area === area),
}));

// 検索意図に合わせたテーマ別ナビ（重複カードは作らず、詳細へアンカー）
const themeGroups = [
  { key: 'ランチ', label: '角島ランチ', note: '島内と本州側でいただける食事処。道の駅からカフェまで。' },
  { key: '海鮮丼', label: '角島海鮮丼', note: '日本海の新鮮な魚介を使った海鮮丼。' },
  { key: 'カフェ', label: '角島カフェ', note: '海を見ながら休めるカフェ・スイーツ。' },
];
const byTheme = themeGroups.map((t) => ({
  ...t,
  items: restaurants.filter((r) => r.themes.includes(t.key)),
}));
---
<Base
  title="角島のランチ・グルメガイド｜海鮮丼・カフェ・食事処"
  description="角島周辺のグルメガイド。海鮮丼・ランチ・カフェ・スイーツを、旅の動線とメニューから選べます。営業時間は変わりやすいため、訪問前の確認を。"
  image="/images/store.jpg"
  breadcrumbs={crumbs}
  schemas={[itemListSchema(restaurants, '/food')]}
>
  <PageHeader
    eyebrow="周辺グルメ"
    title="角島のランチ・グルメガイド"
    lead="海鮮丼・ランチ・カフェ・スイーツ。島内と本州側の店を、メニューから選べます。"
    image="/images/store.jpg"
    alt="角島の売店・休憩施設のイメージ"
  />

  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="rounded-2xl bg-sky/50 px-5 py-4 text-sm text-ink">
      <b>島にコンビニはありません。</b>
      飲み物や軽食は、本州側か「しおかぜの里 角島」で先に用意しておくと安心です。営業時間・定休日は変わりやすいため、
      お出かけ前に各店の最新情報をご確認ください。
    </div>
  </div>

  <!-- テーマ別ナビ（検索意図に合わせて） -->
  <section class="mx-auto max-w-6xl px-4 pb-2 md:px-6">
    <h2 class="mb-5 font-serif text-2xl text-ink">メニューから探す</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {
        byTheme.map((g) => (
          <div class="rounded-3xl border border-deep/15 bg-white p-5">
            <h3 class="font-serif text-lg text-deep">{g.label}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{g.note}</p>
            <ul class="mt-3 space-y-1.5">
              {g.items.map((r) => (
                <li>
                  <a href={`#${r.id}`} class="text-sm text-ink underline decoration-deep/30 underline-offset-2 hover:text-deep">
                    {r.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 店舗比較表（1画面目） -->
  <section class="mx-auto max-w-6xl px-4 py-10 md:px-6">
    <h2 class="mb-5 font-serif text-2xl text-ink">店舗比較</h2>
    <div class="overflow-x-auto rounded-3xl border border-black/5 bg-white">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-sky/40 text-ink">
          <tr>
            <th class="px-4 py-3 font-medium">店名</th>
            <th class="px-4 py-3 font-medium">エリア</th>
            <th class="px-4 py-3 font-medium">おすすめ</th>
            <th class="px-4 py-3 font-medium">営業情報</th>
            <th class="px-4 py-3 font-medium">地図</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/5">
          {
            restaurants.map((r) => (
              <tr class="align-top">
                <td class="px-4 py-3"><a href={`#${r.id}`} class="font-medium text-deep underline underline-offset-2">{r.name}</a></td>
                <td class="px-4 py-3 text-ink-soft">{r.areaLabel}</td>
                <td class="px-4 py-3 text-ink-soft">{r.dish}</td>
                <td class="px-4 py-3 text-ink-soft">{r.hours ?? '要確認'}{r.closed && <span class="block text-xs">定休：{r.closed}</span>}</td>
                <td class="px-4 py-3">
                  <a href={mapsUrl(r.name)} target="_blank" rel="noopener" class="text-deep underline underline-offset-2">地図↗</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-soft">
      「地図↗」は各店舗名で Google マップを検索します。営業時間・定休日は変わりやすいため、最新情報をご確認ください。
    </p>
  </section>

  <!-- エリア別詳細 -->
  {
    byArea.map((group) => (
      <section class="mx-auto max-w-6xl px-4 pb-6 md:px-6">
        <h2 class="mb-6 font-serif text-2xl text-ink">{group.title}</h2>
        <div class="grid gap-5 md:grid-cols-2">
          {group.items.map((r) => (
            <article id={r.id} class="flex flex-col overflow-hidden rounded-3xl border border-black/5 bg-white shadow-soft sm:flex-row">
              <img
                src={r.image}
                alt={r.alt}
                class="h-44 w-full object-cover sm:h-auto sm:w-40 sm:shrink-0"
                loading="lazy"
              />
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-serif text-lg text-ink">{r.name}</h3>
                  {r.status === 'verify' && (
                    <span class="shrink-0 rounded-full bg-wood/10 px-2 py-0.5 text-[10px] text-wood">
                      要確認
                    </span>
                  )}
                </div>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink-soft">{r.summary}</p>
                <p class="mt-2 text-sm text-deep">おすすめ：{r.dish}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {r.tags.map((t) => (
                    <span class="rounded-full bg-sand px-2.5 py-0.5 text-[11px] text-ink-soft">{t}</span>
                  ))}
                </div>
                {(r.hours || r.closed) && (
                  <dl class="mt-3 border-t border-black/5 pt-3 text-xs text-ink-soft">
                    {r.hours && (
                      <div class="flex gap-2">
                        <dt class="shrink-0 font-medium text-ink">営業</dt>
                        <dd>{r.hours}</dd>
                      </div>
                    )}
                    {r.closed && (
                      <div class="flex gap-2">
                        <dt class="shrink-0 font-medium text-ink">定休</dt>
                        <dd>{r.closed}</dd>
                      </div>
                    )}
                  </dl>
                )}
                <a
                  href={mapsUrl(r.name)}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-flex w-fit items-center gap-1 rounded-full bg-deep px-4 py-2 text-xs font-medium text-white transition-transform hover:-translate-y-0.5"
                >
                  地図で見る↗
                </a>
                <p class="mt-2 text-[10px] text-ink-soft/70">
                  最終確認 {r.lastVerified}・訪問前に営業状況をご確認ください
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
  <div class="pb-12"></div>
</Base>
