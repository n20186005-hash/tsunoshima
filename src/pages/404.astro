---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---
<Base title="ページが見つかりません">
  <section class="relative">
    <img src="/images/sea.jpg" alt="角島の澄んだ海" class="absolute inset-0 h-full w-full object-cover" />
    <div class="scrim absolute inset-0"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 text-center text-white">
      <p class="font-serif text-6xl">404</p>
      <h1 class="mt-3 font-serif text-2xl">この道は、どこにもつながっていないようです</h1>
      <p class="mt-3 text-sand/85">お探しのページが見つかりませんでした。</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        <a href="/" class="rounded-full bg-white px-5 py-2.5 text-sm font-medium text-ink">ホームへ戻る</a>
        {
          nav.slice(0, 4).map((n) => (
            <a
              href={n.href}
              class="rounded-full border border-white/60 px-5 py-2.5 text-sm text-white backdrop-blur hover:bg-white/15"
            >
              {n.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
