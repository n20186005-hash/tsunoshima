---
import { attractions, categoryLabel } from '../data/attractions';
---
<section class="mx-auto max-w-6xl px-4 md:px-6" aria-labelledby="plan-title" data-plan>
  <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
    <!-- 選ぶ -->
    <div>
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 id="plan-title" class="font-serif text-2xl text-ink">わたしの角島 半日プラン</h2>
          <p class="mt-1 text-sm text-ink-soft">
            行きたい場所を選ぶと、滞在時間の目安とシェアカードを作れます。
          </p>
        </div>
        <button
          type="button"
          data-plan-reset
          class="text-xs text-ink-soft underline underline-offset-4 hover:text-ink"
        >
          選択をリセット
        </button>
      </div>

      <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
        {
          attractions.map((a) => (
            <li>
              <label
                class="flex cursor-pointer items-start gap-3 rounded-2xl border border-black/5 bg-white p-3.5 transition-colors has-[:checked]:border-deep has-[:checked]:bg-sky/40"
              >
                <input
                  type="checkbox"
                  value={a.id}
                  data-plan-item
                  data-minutes={a.minutes}
                  data-name={a.name}
                  class="mt-1 h-4 w-4 shrink-0 accent-deep"
                />
                <span>
                  <span class="flex items-center gap-2">
                    <span class="font-medium text-ink">{a.name}</span>
                    <span class="rounded-full bg-sand px-2 py-0.5 text-[10px] text-ink-soft">
                      {categoryLabel[a.category]}
                    </span>
                  </span>
                  <span class="mt-0.5 block text-xs text-ink-soft">{a.note}・約{a.minutes}分</span>
                </span>
              </label>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- まとめ -->
    <div class="lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-3xl border border-deep/10 bg-white p-6 shadow-soft">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold tracking-widest text-deep">プランの合計</p>
            <p class="mt-1 text-sm text-ink-soft" data-plan-count>0 か所を選択中</p>
          </div>
          <div class="text-right">
            <span class="tnum font-serif text-3xl text-ink" data-plan-total>0</span>
            <span class="text-sm text-ink-soft"> 分</span>
          </div>
        </div>

        <ol class="mt-4 space-y-1.5 text-sm text-ink" data-plan-list>
          <li class="text-ink-soft">まだ選ばれていません。</li>
        </ol>

        <div class="mt-5 grid grid-cols-1 gap-2">
          <button
            type="button"
            data-plan-share
            data-ga="share_card_generate"
            class="rounded-full bg-deep px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink disabled:opacity-40"
            disabled
          >
            シェアカードを作る
          </button>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              data-plan-copy
              data-ga="route_save"
              class="rounded-full border border-ink/15 px-4 py-2.5 text-sm text-ink transition-colors hover:bg-white disabled:opacity-40"
              disabled
            >
              順番をコピー
            </button>
            <button
              type="button"
              data-plan-link
              data-ga="route_share"
              class="rounded-full border border-ink/15 px-4 py-2.5 text-sm text-ink transition-colors hover:bg-white disabled:opacity-40"
              disabled
            >
              リンクを共有
            </button>
          </div>
        </div>
        <p class="mt-3 text-xs text-ink-soft" data-plan-msg aria-live="polite"></p>
      </div>
    </div>
  </div>

  <!-- シェアカードのプレビュー -->
  <dialog
    data-card-dialog
    class="m-auto w-[min(94vw,420px)] rounded-3xl bg-transparent p-0 backdrop:bg-ink/60"
  >
    <div class="rounded-3xl bg-white p-4">
      <div class="mb-3 flex items-center justify-center gap-2">
        <button type="button" data-ratio="1" class="ratio-btn">1:1</button>
        <button type="button" data-ratio="0.8" class="ratio-btn">4:5</button>
        <button type="button" data-ratio="0.5625" class="ratio-btn">9:16</button>
      </div>
      <canvas data-card-canvas class="mx-auto block h-auto w-full rounded-2xl shadow-soft"></canvas>
      <div class="mt-4 grid grid-cols-2 gap-2">
        <button
          type="button"
          data-card-download
          class="rounded-full bg-deep px-4 py-2.5 text-sm font-medium text-white hover:bg-ink"
        >
          画像を保存
        </button>
        <button
          type="button"
          data-card-close
          class="rounded-full border border-ink/15 px-4 py-2.5 text-sm text-ink hover:bg-sand"
        >
          閉じる
        </button>
      </div>
    </div>
  </dialog>
</section>

<style>
  .ratio-btn {
    border-radius: 9999px;
    border: 1px solid rgba(25, 49, 57, 0.15);
    padding: 0.25rem 0.85rem;
    font-size: 0.8rem;
    color: #48606a;
  }
  .ratio-btn[aria-pressed='true'] {
    background: #126d82;
    color: #fff;
    border-color: #126d82;
  }
</style>

<script>
  const root = document.querySelector('[data-plan]') as HTMLElement;
  if (root) {
    const items = Array.from(
      root.querySelectorAll('[data-plan-item]'),
    ) as HTMLInputElement[];
    const totalEl = root.querySelector('[data-plan-total]')!;
    const countEl = root.querySelector('[data-plan-count]')!;
    const listEl = root.querySelector('[data-plan-list]')!;
    const msg = root.querySelector('[data-plan-msg]')!;
    const shareBtn = root.querySelector('[data-plan-share]') as HTMLButtonElement;
    const copyBtn = root.querySelector('[data-plan-copy]') as HTMLButtonElement;
    const linkBtn = root.querySelector('[data-plan-link]') as HTMLButtonElement;
    const resetBtn = root.querySelector('[data-plan-reset]') as HTMLButtonElement;

    const KEY = 'tsuno-plan';

    const selected = () => items.filter((i) => i.checked);

    function flash(text: string) {
      msg.textContent = text;
      window.setTimeout(() => (msg.textContent = ''), 2600);
    }

    function persist() {
      const ids = selected().map((i) => i.value);
      try {
        localStorage.setItem(KEY, JSON.stringify(ids));
      } catch {}
      const u = new URL(location.href);
      if (ids.length) u.searchParams.set('plan', ids.join(','));
      else u.searchParams.delete('plan');
      history.replaceState(null, '', u);
    }

    function render() {
      const sel = selected();
      const total = sel.reduce((s, i) => s + Number(i.dataset.minutes), 0);
      totalEl.textContent = String(total);
      countEl.textContent = `${sel.length} か所を選択中`;
      if (sel.length) {
        listEl.innerHTML = sel
          .map(
            (i, n) =>
              `<li class="flex gap-2"><span class="text-shallow tnum">${n + 1}.</span><span>${i.dataset.name}</span></li>`,
          )
          .join('');
      } else {
        listEl.innerHTML = '<li class="text-ink-soft">まだ選ばれていません。</li>';
      }
      [shareBtn, copyBtn, linkBtn].forEach((b) => (b.disabled = sel.length === 0));
    }

    function restore() {
      let ids: string[] = [];
      const p = new URL(location.href).searchParams.get('plan');
      if (p) ids = p.split(',');
      else {
        try {
          ids = JSON.parse(localStorage.getItem(KEY) || '[]');
        } catch {}
      }
      items.forEach((i) => (i.checked = ids.includes(i.value)));
      render();
    }

    items.forEach((i) =>
      i.addEventListener('change', () => {
        render();
        persist();
        (window as any).gtag?.('event', 'nearby_attraction_add', { id: i.value, on: i.checked });
      }),
    );

    resetBtn?.addEventListener('click', () => {
      items.forEach((i) => (i.checked = false));
      render();
      persist();
    });

    copyBtn?.addEventListener('click', async () => {
      const text = selected()
        .map((i, n) => `${n + 1}. ${i.dataset.name}`)
        .join('\n');
      try {
        await navigator.clipboard.writeText('角島 わたしのプラン\n' + text);
        flash('順番をコピーしました。');
      } catch {
        flash('コピーできませんでした。');
      }
    });

    linkBtn?.addEventListener('click', async () => {
      persist();
      const url = location.href;
      try {
        if (navigator.share) await navigator.share({ title: '角島 わたしのプラン', url });
        else {
          await navigator.clipboard.writeText(url);
          flash('リンクをコピーしました。');
        }
      } catch {}
    });

    // ---- シェアカード（Canvas） ----
    const dialog = root.querySelector('[data-card-dialog]') as HTMLDialogElement;
    const canvas = root.querySelector('[data-card-canvas]') as HTMLCanvasElement;
    const ratioBtns = Array.from(root.querySelectorAll('[data-ratio]')) as HTMLButtonElement[];
    let ratio = 1;
    let bg: HTMLImageElement | null = null;

    function loadBg(): Promise<HTMLImageElement> {
      return new Promise((resolve, reject) => {
        if (bg) return resolve(bg);
        const img = new Image();
        img.onload = () => {
          bg = img;
          resolve(img);
        };
        img.onerror = reject;
        img.src = '/images/bridge-classic.jpg';
      });
    }

    function draw() {
      const W = 1080;
      const H = Math.round(W / ratio);
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext('2d')!;
      // 背景写真（cover）
      if (bg) {
        const s = Math.max(W / bg.width, H / bg.height);
        const w = bg.width * s,
          h = bg.height * s;
        ctx.drawImage(bg, (W - w) / 2, (H - h) / 2, w, h);
      } else {
        ctx.fillStyle = '#126d82';
        ctx.fillRect(0, 0, W, H);
      }
      // スクリム
      const g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, 'rgba(9,30,38,0.15)');
      g.addColorStop(0.55, 'rgba(9,30,38,0.35)');
      g.addColorStop(1, 'rgba(9,30,38,0.85)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);

      const pad = 72;
      ctx.textBaseline = 'alphabetic';
      // ブランド
      ctx.fillStyle = 'rgba(217,238,242,0.9)';
      ctx.font = '600 30px "Zen Kaku Gothic New", sans-serif';
      ctx.fillText('角島展望台  TSUNOSHIMA VIEWPOINT', pad, pad + 20);

      // 見出し
      ctx.fillStyle = '#ffffff';
      ctx.font = '500 66px "Shippori Mincho", serif';
      ctx.fillText('海へ続く道を、', pad, H - 300);
      ctx.fillText('見つけた。', pad, H - 300 + 82);

      // メタ情報
      const sel = selected();
      const date = new Date().toLocaleDateString('ja-JP', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const blue = (window as any).__tsunoBlue;
      ctx.font = '500 30px "Zen Kaku Gothic New", sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,0.92)';
      let y = H - 140;
      ctx.fillText(`${date} ・ ${sel.length}スポットを計画`, pad, y);
      if (typeof blue === 'number') {
        y += 46;
        ctx.fillText(`角島ブルー指数  ${blue} / 100`, pad, y);
      }

      // 下の細い橋ライン
      ctx.strokeStyle = '#42b9c5';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(pad, H - 60);
      ctx.bezierCurveTo(W * 0.4, H - 90, W * 0.6, H - 40, W - pad, H - 70);
      ctx.stroke();
    }

    async function openCard() {
      await loadBg().catch(() => {});
      draw();
      if (!dialog.open) dialog.showModal();
    }

    ratioBtns.forEach((b) =>
      b.addEventListener('click', () => {
        ratio = Number(b.dataset.ratio);
        ratioBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        draw();
      }),
    );
    ratioBtns[0]?.setAttribute('aria-pressed', 'true');

    shareBtn?.addEventListener('click', openCard);
    root.querySelector('[data-card-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    root.querySelector('[data-card-download]')?.addEventListener('click', () => {
      const a = document.createElement('a');
      a.download = 'tsunoshima-plan.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
    });

    restore();
  }
</script>
