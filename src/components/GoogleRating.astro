---
// Google マップの評価を「ページ表示のみ」で示す。
// 評価は JSON-LD には含めず、出所・同期時期・著作権を明記して Google のガイドラインに沿う。
import { attraction } from '../data/attraction';

const r = attraction.rating;
const fillPct = (r.score / 5) * 100;
const reviewsText = r.reviews.toLocaleString('en-US');
---

<div class="rounded-3xl border border-deep/15 bg-white/85 p-6 shadow-soft">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="font-serif text-4xl leading-none text-ink tnum">{r.score.toFixed(1)}</span>
    <!-- 5段階の星（評価に応じて塗りつぶし幅を制御） -->
    <span class="relative inline-block text-2xl leading-none" role="img" aria-label={`Google マップ評価 ${r.score} / 5`}>
      <span class="text-black/15">★★★★★</span>
      <span
        class="absolute left-0 top-0 overflow-hidden whitespace-nowrap text-[#fbbc04]"
        style={`width:${fillPct}%`}
      >★★★★★</span>
    </span>
    <span class="text-sm text-ink-soft">
      Google マップ · <span class="tnum">{reviewsText}</span> 件の評価
    </span>
  </div>

  <!-- 評価表示のすぐ下の小字（出所＋同期時期） -->
  <p class="mt-3 text-xs leading-relaxed text-ink-soft">
    {r.inlineNote}<a
      href={attraction.mapsShareUrl}
      target="_blank"
      rel="noopener"
      class="text-deep underline underline-offset-2"
      >{r.inlineNoteLink}</a
    >
  </p>

  <!-- 評価ブロックの出所説明 -->
  <p class="mt-2 text-xs leading-relaxed text-ink-soft">{r.sourceNote}</p>

  <a
    href={attraction.mapsShareUrl}
    target="_blank"
    rel="noopener"
    data-ga="google_reviews_click"
    class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-deep px-5 py-2.5 text-sm font-medium text-white shadow-soft transition-transform hover:-translate-y-0.5"
  >
    {r.buttonLabel}
    <span aria-hidden="true">↗</span>
  </a>
</div>
